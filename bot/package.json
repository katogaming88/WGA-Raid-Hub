{
  "name": "guild-team-bot",
  "version": "3.94.0",
  "description": "Discord bot for WoW guild teams (M+ exclusions, roster apps, resend)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "discord.js": "^14.15.3",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/express": "^4.17.21",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.5.10",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
