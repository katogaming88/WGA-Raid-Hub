# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*.code-workspace

# Local env / secrets (.env.example is tracked on purpose: it is the template)
.env
.env.local

# Claude / local config
.claude/
# CLAUDE.md is Claude Code's own orientation notes for this repo, kept on the
# machine that wrote them rather than shared -- Kat's call, 2026-09-19.
CLAUDE.md

# Node
node_modules/
npm-debug.log*

# The bot's TypeScript build output (#953). node_modules/, .env and data/ above
# are already matched at any depth, so bot/ needs nothing else.
bot/dist/

# TypeScript's cache of what it already checked (#1320). No tsconfig here asks
# for one and no npm script writes one, but an editor's TypeScript service or
# any type check run with --incremental drops it beside the config it used, in
# app/ or bot/. It is machine-specific and rebuilt from nothing, so it is never
# worth committing.
*.tsbuildinfo

# One-time migration data (sheet CSV exports and generated SQL, see #320)
data/
# ...but the new app's data layer is source code, not an export (#1101).
!app/src/data/

# Per-tier item catalog scratch output (scripts/fetch-items.js,
# scripts/items-csv-to-sql.js) -- regenerated every raid tier, never committed
items.csv
item_bosses_raw.csv
items_insert.sql

# scripts/fetch-item-stats.js scratch output (#560) -- regenerated per run
item_ids.csv
item_stats_update.sql

# scripts/fetch-tier-resolved-items.js / generate-tier-token-map-sql.js
# scratch output -- regenerated per run, same category as items.csv above
tier_resolved_items.csv
tier_resolved_items_insert.sql
tier_token_map_insert.sql

# RCLC loot import scratch paste, see conversation w/ Claude 2026-08-28
rclc-tonight-combined.json

# Impeccable design-skill scratch (decision pages, mocks), see conversation w/ Claude 2026-09-13
.impeccable/
