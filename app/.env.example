# Build-time settings for the app (#1101). Vite reads .env.development for
# npm run dev and .env.production for npm run build.

# Which Supabase to talk to. Local: the stack from supabase start. The keys
# are public (anon/publishable); access is enforced by the database's rules.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<anon key from supabase status>

# Where the app lands on "/" until sign-in picks the person's own team.
VITE_DEFAULT_PATH=/g/wga/t/phoenix
