# Local values for the scripts at the repo root. Copy to .env, which is
# gitignored. scripts/fetch-item-stats.js reads it.
#
# The rest live elsewhere: the site's Supabase URL and public key are in
# js/common.js, the new app's in app/.env.*, the Edge Functions' local values
# in supabase/functions/.env.example, the local stack's sign-in secrets in
# supabase/.env.example, the bot's in bot/.env (bot/DEPLOYMENT.md), and
# database access goes through the psql services
# (docs/claude-readonly-db-access.md).

# Blizzard Game Data API (local-only, client_credentials flow -- see develop.battle.net)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
