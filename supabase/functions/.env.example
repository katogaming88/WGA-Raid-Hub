# Local values for `supabase functions serve`. Copy to .env in this directory,
# which is gitignored. Nothing here is a production secret and nothing here is
# read by a deployed function: production reads Project Settings > Edge
# Functions > Secrets.
#
# Where a Discord post goes is decided by the function from where it runs
# (#1081): on a local stack every poster sends to DISCORD_TEST_WEBHOOK_URL,
# marked [local] with nobody pinged, whatever the live names below hold, and
# with it unset the post is skipped. The live names are read on production
# only, so locally the one line that matters is the test webhook, aimed at
# the sink for a rehearsal (section 11 of docs/supabase-local-dev-setup.md)
# or at the test channel's webhook to see the post in Discord:
#
#   npm run dev:sink
#   DISCORD_TEST_WEBHOOK_URL=http://host.docker.internal:8899/webhooks/test-channel
#
# host.docker.internal rather than 127.0.0.1, because the functions runtime is
# a container and cannot see the machine's own localhost.
# OPTIONAL_RSVP_REMINDERS_SECRET is any value you like locally.

# The local stacks' destination (#1081). The test channel's webhook URL is the
# right to post there, so it is a one-time paste on each machine and never a
# production secret: nothing deployed reads this name.
DISCORD_TEST_WEBHOOK_URL=

# WarcraftLogs OAuth app credentials (#223). Same secrets already configured
# in Project Settings > Edge Functions > Secrets for the deployed function
# (per #205) -- this file is only for local `supabase functions serve`.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Discord native incoming webhook for the BoE Found channel (#746). Read on
# production only; unset there means boe-webhook no-ops with { skipped: true }.
BOE_WEBHOOK_URL=

# Where the sold ping goes (#873). Optional: boe-sold-webhook reads this
# first and falls back to BOE_WEBHOOK_URL, so leaving it blank puts the sold
# message in the found channel. With neither set it no-ops too.
BOE_SOLD_WEBHOOK_URL=

# Discord native incoming webhook for the contact form's admin channel
# (#791). Same shape as the two above; unset means contact-webhook no-ops.
CONTACT_WEBHOOK_URL=

# The operator credential the cron functions check (#895): the x-cron-secret
# header optional-rsvp-reminders wants. Any value locally; on prod it is the
# secret in vault that the pg_cron job sends.
OPTIONAL_RSVP_REMINDERS_SECRET=

# Where discord-bot-webhook relays to (#224, consolidated onto one bot by
# #991). Both are required together: without the pair the function errors
# rather than no-opping, because one shared destination means a missing one is
# a real misconfiguration. Point the URL at the sink to watch what the bot
# would have been sent.
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
