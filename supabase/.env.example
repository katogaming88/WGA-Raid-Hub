# Local values for the local Supabase stack's sign-in. Copy to .env in this
# directory, which is gitignored. The seeded personas cover every role without
# any of it (section 9 of docs/supabase-local-dev-setup.md).

# Battle.net sign-in on the new app (#1157): `npm run dev:battlenet` reads it
# to add the provider after every reset. The "WGA Raid Hub sign-in" client's
# secret, from develop.battle.net.
BATTLENET_SIGNIN_CLIENT_SECRET=

# Real Discord sign-in, for testing Battle.net and Discord account linking
# (#1157). The CLI reads both for the [auth.external.discord] block in
# config.toml; leave them out and the stack starts with Discord sign-in off.
# SUPABASE_AUTH_EXTERNAL_DISCORD_ENABLED=true
# SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
